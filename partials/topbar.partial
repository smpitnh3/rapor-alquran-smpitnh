<header class="topbar">
  <div class="topbar-left">
    <img
      src="assets/images/logo-nurhikmah.png"
      alt="Logo Nur Hikmah"
      class="topbar-mobile-logo"
    />

    <button
      class="back-button"
      id="sidebarToggle"
      type="button"
      aria-label="Minimize sidebar"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15.75 19.5 8.25 12l7.5-7.5"
        />
      </svg>
    </button>

    <div class="topbar-title">
      <h1>Dashboard</h1>
      <p>Ringkasan capaian dan kelengkapan data rapor Al-Qur’an.</p>
    </div>
  </div>

  <button
    class="hamburger-button"
    id="mobileSidebarOpen"
    type="button"
    aria-label="Buka menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="topbar-right">
    <button
      class="icon-button"
      id="themeToggle"
      type="button"
      aria-label="Ganti mode tampilan"
    >
      <span id="themeIcon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
          />
        </svg>
      </span>
    </button>

    <div class="account-dropdown" id="accountDropdown">
      <button
        class="account-menu"
        id="accountMenuButton"
        type="button"
        aria-label="Buka menu akun"
        aria-expanded="false"
      >
        <span id="accountMenuName">Admin/Guru</span>

        <div class="account-avatar" id="accountMenuAvatar">A</div>

        <svg
          class="chevron"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m19.5 8.25-7.5 7.5-7.5-7.5"
          />
        </svg>
      </button>

      <div class="account-dropdown-menu" id="accountDropdownMenu">
        <div class="account-dropdown-header">
          <strong id="accountDropdownName">Admin/Guru</strong>
          <span id="accountDropdownEmail">admin@nurhikmah.sch.id</span>
          <span id="accountDropdownRole">-</span>
        </div>

        <button
          class="account-dropdown-item logout"
          id="logoutButton"
          type="button"
          data-logout
        >
          Keluar
        </button>
      </div>
    </div>
  </div>
</header>
